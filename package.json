{
  "name": "t3code-zh-cn",
  "version": "0.0.2",
  "description": "T3 Code 简体中文本地化补丁与命令行工具",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codepql/t3code-zh-cn.git"
  },
  "homepage": "https://github.com/Codepql/t3code-zh-cn#readme",
  "bugs": {
    "url": "https://github.com/Codepql/t3code-zh-cn/issues"
  },
  "type": "module",
  "bin": {
    "t3code-zh-cn": "bin/t3code-zh-CN.mjs"
  },
  "scripts": {
    "check": "node --check patch.mjs && node --check lib.mjs && node --check platform.mjs && node --check bin/t3code-zh-CN.mjs && node --check tools/build-dict.mjs",
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm test"
  },
  "files": [
    "bin/",
    "vendor/",
    "patch.mjs",
    "lib.mjs",
    "platform.mjs",
    "context-translations.json",
    "display-maps.json",
    "formatter-labels.json",
    "literal-overrides.json",
    "zh-CN.json",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "t3-code",
    "localization",
    "中文",
    "i18n"
  ]
}
